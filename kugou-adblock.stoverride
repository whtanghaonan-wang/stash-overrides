name: Kugou Adblock
desc: Supplemental ad blocking rules for Kugou Music startup promotions and in-app marketing.

rules:
  # Force Kugou/Tencent Music QUIC traffic back to TCP so HTTP/MitM rewrites can see it.
  - AND,((PROTOCOL,QUIC),(OR,((DOMAIN-SUFFIX,kugou.com),(DOMAIN-SUFFIX,kglink.cn),(DOMAIN-SUFFIX,tencentmusic.com),(DOMAIN-SUFFIX,y.qq.com),(DOMAIN-SUFFIX,gtimg.cn),(DOMAIN-SUFFIX,gdt.qq.com),(DOMAIN-SUFFIX,ugdtimg.com)))),REJECT-DROP,no-track

  # Tencent Music / Kugou ad delivery
  - DOMAIN,ad.tencentmusic.com,REJECT
  - DOMAIN,adstats.tencentmusic.com,REJECT
  - DOMAIN,adsmind.gdtimg.com,REJECT
  - DOMAIN,d.kugou.com,REJECT
  - DOMAIN,log.stat.kugou.com,REJECT
  - DOMAIN,mdpfilebssdlbig.kugou.com,REJECT
  - DOMAIN,splashimgretrybssdl.cloud.kugou.com,REJECT
  - DOMAIN,tmead.y.qq.com,REJECT
  - DOMAIN,tmeadcomm.y.qq.com,REJECT
  - DOMAIN-SUFFIX,gdt.qq.com,REJECT
  - DOMAIN-SUFFIX,pgdt.gtimg.cn,REJECT
  - DOMAIN-SUFFIX,ugdtimg.com,REJECT
  - DOMAIN,ios.bugly.qq.com,REJECT
  - DOMAIN,sdk.e.qq.com,REJECT

  # Apple ad attribution / iAd endpoints observed during Kugou startup
  - DOMAIN,api-adservices.apple.com,REJECT
  - DOMAIN,ca.iadsdk.apple.com,REJECT

  # Kugou startup promotion / operations / activity surfaces
  - DOMAIN,welfare.kugou.com,REJECT
  - DOMAIN,vipos.kugou.com,REJECT
  - DOMAIN,acsing.service.kugou.com,REJECT
  - DOMAIN,fx.service.kugou.com,REJECT

  # Tencent ad tracking / delivery / telemetry observed with Kugou
  - DOMAIN,us.l.qq.com,REJECT
  - DOMAIN,h.trace.qq.com,REJECT
  - DOMAIN,rdelivery.qq.com,REJECT
  - DOMAIN,receiver.tdm.qq.com,REJECT
  - DOMAIN,hc.tdm.qq.com,REJECT
  - DOMAIN,tmfmazuhttp-wangka.m.qq.com,REJECT

  # Kugou analytics / collection endpoints
  - DOMAIN,nbcollect.kugou.com,REJECT
  - DOMAIN,nbcollectretry.kugou.com,REJECT
  - DOMAIN,rt-m.kugou.com,REJECT
  - DOMAIN,mobilelog.kugou.com,REJECT
  - DOMAIN,log.web.kugou.com,REJECT
  - DOMAIN,report.tencentmusic.com,REJECT

http:
  force-http-engine:
    - '*.kugou.com:80'
    - '*.kglink.cn:80'
    - '*.tencentmusic.com:80'
    - '*.y.qq.com:80'
    - '*.gtimg.cn:80'
    - '*.gdt.qq.com:80'
    - '*.ugdtimg.com:80'

  mitm:
    - '*.kugou.com'
    - '*.kglink.cn'
    - adservice.kugou.com
    - adserviceretry.kugou.com
    - adserviceretry.kglink.cn
    - gateway.kugou.com
    - gatewayretry.kugou.com
    - acshow.kugou.com
    - acshow2.kugou.com
    - bjacshow.kugou.com
    - bjacshow2.kugou.com
    - service1.fanxing.kugou.com
    - service3.fanxing.kugou.com
    - fx.service.kugou.com
    - hwstore.kugou.com
    - ep.kugou.com
    - gzacshow.kugou.com
    - m1fxgroup.kugou.com
    - d.kugou.com
    - papi.kugou.com
    - mpservice.kugou.com
    - mcloudservice.kugou.com
    - gtools.kugou.com
    - tools.mobile.kugou.com
    - vipos.kugou.com
    - welfare.kugou.com
    - kugouitg.kugou.com
    - online.kugou.com
    - api.tencentmusic.com

  url-rewrite:
    # Startup and in-app ad configuration
    - ^http:\/\/log\.stat\.kugou\.com\/mobile\/ad\.html - reject
    - ^https:\/\/fx\.service\.kugou\.com\/mfx-kugoulive\/ad\/ - reject-dict
    - ^https:\/\/gateway(retry)?\.kugou\.com\/adp\/ad\/ - reject-dict
    - ^https:\/\/gateway(retry)?\.kugou\.com\/ads\.gateway\/ - reject-dict

    # Feed, task, search, player and comment promotions
    - ^https:\/\/gateway(retry)?\.kugou\.com\/v\d\/feeds\/follow_feed_fallback - reject-dict
    - ^https:\/\/gateway(retry)?\.kugou\.com\/mstc\/musicsymbol\/v\d\/system\/profile - reject-dict
    - ^https:\/\/gateway(retry)?\.kugou\.com\/searchnofocus\/v\d\/search_no_focus_word - reject-dict
    - ^https:\/\/gateway(retry)?\.kugou\.com\/adp\/bubble\/v\d\/song_play - reject-dict
    - ^https:\/\/gateway(retry)?\.kugou\.com\/singerdiscuss\/v\d\/entrance\/comment - reject-dict
    - ^https:\/\/gateway(retry)?\.kugou\.com\/r\/v\d\/general\/putin\/midad - reject-dict
    - ^https:\/\/gateway(retry)?\.kugou\.com\/ocean\/v\d\/sound\/banner - reject-dict
    - ^https:\/\/(?:gateway(?:retry)?|papi|mpservice|mcloudservice|gtools|tools\.mobile|d|online|kugouitg|vipos|welfare)\.kugou\.com\/.*(?:\/|_|-|\.)(?:ad|ads|adp|advert|startup|launch|popup|pop|promotion|promote|operation|operate|marketing|commercial|activity|vipos|welfare)(?:\/|\?|&|_|-|\.|$) - reject-dict
    - ^https:\/\/(?:api|ad|adstats)\.tencentmusic\.com\/.*(?:\/|_|-|\.)(?:ad|ads|advert|splash|startup|launch|popup|pop|promotion|promote|operation|operate|marketing|commercial|activity)(?:\/|\?|&|_|-|\.|$) - reject-dict
    - ^https:\/\/(?:tmead|tmeadcomm)\.y\.qq\.com\/ - reject-dict

    # Live, store and album shop promotions
    - ^https:\/\/gzacshow\.kugou\.com\/mfanxing-home\/cdn\/room\/index\/list_v2 - reject-dict
    - ^https:\/\/gzacshow\.kugou\.com\/mfx-rt-show\/cdn\/mo\/show\/headline - reject-dict
    - ^https:\/\/m1fxgroup\.kugou\.com\/fxsing\/yqc\/alongInfo\/getUserAlongInfo - reject-dict
    - ^https:\/\/hwstore\.kugou\.com\/v\d\/get_store_data - reject-dict
    - ^https:\/\/ep\.kugou\.com\/v\d\/album_shop\/get_entrance_info - reject-dict

  script:
    - match: ^https?:\/\/(?:(?:[^\/]+\.)?(?:kugou\.com|kglink\.cn)\/v4\/mobile_splash(?:_sort)?|acshow2?\.kugou\.com\/(?:mfx-shortvideo\/conf\/kv\/app|mfx-kugoulive\/room\/list|show7\/json\/v2\/cdn\/getscfg)|bjacshow2?\.kugou\.com\/mfx-appconf\/cdn\/start\/config\.json|service(?:1|3)\.fanxing\.kugou\.com\/video\/mo\/gateway\/api\/config)(?:\?|$)
      name: kugou-sanitize-ads
      type: response
      require-body: true

    - match: ^https:\/\/gateway(retry)?\.kugou\.com\/ocean\/v\d\/tab\/list_v\d
      name: kugou-clean-tabs
      type: response
      require-body: true

script-providers:
  kugou-sanitize-ads:
    url: https://raw.githubusercontent.com/whtanghaonan-wang/stash-overrides/main/kugou-sanitize-ads.js?v=20260715-v8
    interval: 86400

  kugou-clean-tabs:
    url: https://raw.githubusercontent.com/whtanghaonan-wang/stash-overrides/main/kugou-clean-tabs.js
    interval: 86400
